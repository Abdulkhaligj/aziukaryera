# Admin panel (public values only). After the cutover: the MySQL API address and its ANON_KEY.
NEXT_PUBLIC_API_URL=https://api.career.asoiu.edu.az
NEXT_PUBLIC_API_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_APP_URL=https://asoiu-career-admin.vercel.app

# AI keys live only on the server, in deploy/universitet-mysql/api.env (GEMINI_API_KEY, GROQ_API_KEY).

# Reserved for a future payment adapter. Do not use test or production secrets in Git.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
