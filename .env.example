# Admin panel - browser-safe values only
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Edge Function secrets - set with `supabase secrets set`, never expose to browser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Reserved for a future payment adapter. Do not use test or production secrets in Git.
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=
