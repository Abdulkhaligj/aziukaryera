# HTTPS with an automatic Let's Encrypt certificate for API_DOMAIN.
# Security headers for every answer (audit 2026-11-13, #59).
{$API_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
	}
	# The largest upload is 50 MB (storage); larger bodies stop here.
	request_body {
		max_size 60MB
	}
	reverse_proxy api:8000
}
