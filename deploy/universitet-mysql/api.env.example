# API settings. scripts/01-init.sh copies this to api.env and fills the keys.
# Never commit api.env: it holds the JWT secret and the service key.

# JWT secret and the anon / service_role keys signed with it (generated).
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# The sites that may use the API (auth redirects).
SITE_URL=https://asoiu-career.vercel.app
ADDITIONAL_REDIRECT_URLS=https://asoiu-career-admin.vercel.app/**
PUBLIC_SITE_URL=https://asoiu-career.vercel.app
UNIVERSITY_EMAIL_DOMAIN=asoiu.edu.az
# false = sign-ups confirm their email with a code (needs SMTP below). true only
# for a short test: anyone could then register with someone else's address.
ENABLE_EMAIL_AUTOCONFIRM=false

# Email for sign-up confirmation, password recovery and admin invites.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=career@asoiu.edu.az
SMTP_SENDER_NAME=ADNSU Karyera Mərkəzi

# Edge Functions (AIDA, Career AI, admin assistant, moderation).
GEMINI_API_KEY=
GROQ_API_KEY=
# 48 random characters (generated); the moderation webhook sends it. Only here,
# not in the database.
MODERATION_WEBHOOK_SECRET=
# Key for fields encrypted at rest (benefit claim codes): base64 of 32 bytes
# (generated). Keep it with the backup key: without it those codes cannot be read.
DATA_ENCRYPTION_KEY=
# Browser origins besides SITE_URL and ADDITIONAL_REDIRECT_URLS that may call the API (comma list).
CORS_ORIGINS=

# Scheduled jobs (moderation retries, subscription lifecycle).
ENABLE_JOBS=true
