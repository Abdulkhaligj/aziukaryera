# Copied to kit.env by scripts/01-init.sh (passwords are generated there).
# The address of the site and the API (the site's pages and /auth, /rest, /storage, /functions).
API_DOMAIN=career.asoiu.edu.az
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Caddy's site address. Empty: API_DOMAIN with an automatic Let's Encrypt certificate
# (ports 80/443 of this server open to the internet). Behind the university's web
# application firewall, which holds the HTTPS certificate and forwards here: :80
CADDY_SITE_ADDRESS=
# Behind that firewall: its address(es) as this server sees them, separated by spaces
# and IN DOUBLE QUOTES (the scripts read this file with bash), e.g. for ASOIU:
#   TRUSTED_PROXIES="172.17.129.39/32 172.17.129.1/32"
# Only from there is the visitor's address in X-Forwarded-For believed; empty =
# nobody (every visitor then counts as the firewall's address).
TRUSTED_PROXIES=
# Where /admin on this address forwards (the admin panel); empty = the Vercel one.
ADMIN_URL=
# Backups (scripts/backup.sh) are always encrypted with this key file (chmod 600).
# scripts/01-init.sh creates deploy/universitet-mysql/backup.key when it is empty.
# Keep a copy of the key off the server, or the backups cannot be restored.
BACKUP_KEY_FILE=
# Off-host copy (rsync target, e.g. backup@10.0.0.5:/srv/asoiu); empty = none.
BACKUP_REMOTE=
