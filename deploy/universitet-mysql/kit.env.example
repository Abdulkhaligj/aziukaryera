# Copied to kit.env by scripts/01-init.sh (passwords are generated there).
API_DOMAIN=api.career.asoiu.edu.az
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Backups (scripts/backup.sh). Key file for encryption (root, chmod 600); empty = not encrypted.
#   sudo sh -c 'umask 077; openssl rand -base64 48 > /root/asoiu-backup.key'
# Keep a copy of the key off the server, or the backups cannot be restored.
BACKUP_KEY_FILE=
# Off-host copy (rsync target, e.g. backup@10.0.0.5:/srv/asoiu); empty = none.
BACKUP_REMOTE=
