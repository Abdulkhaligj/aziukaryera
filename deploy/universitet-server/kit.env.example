# ASOIU Karyera — universitet serverinə köçürmə parametrləri.
# Bu faylı kit.env adı ilə köçürün və doldurun:  cp kit.env.example kit.env
# kit.env gizli dəyərlər saxlayır və Git-ə düşmür (.gitignore).

# Rəsmi setup.sh-ın yaratdığı self-hosted Supabase qovluğu
SUPABASE_DIR=/opt/supabase/asoiu-career

# API-nin ictimai domeni (DNS A qeydi bu serverə yönəlməlidir). HTTPS sertifikatını Caddy avtomatik alır.
PUBLIC_DOMAIN=api.career.asoiu.edu.az
CERTBOT_EMAIL=career@asoiu.edu.az

# Saytların ünvanları (giriş yönləndirmələri və dəvət linkləri üçün)
SITE_URL=https://asoiu-career.vercel.app
ADMIN_URL=https://asoiu-career-admin.vercel.app

# E-poçt (qeydiyyat təsdiqi, şifrə bərpası, admin dəvətləri)
SMTP_ADMIN_EMAIL=career@asoiu.edu.az
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME="ADNSU Karyera Mərkəzi"
# Bu gün buludda e-poçt təsdiqi söndürülüb (true). SMTP işlədikdən sonra false edin.
ENABLE_EMAIL_AUTOCONFIRM=true

# AI açarları (buludda Edge Function secret-ləridir; dəyəri Google AI Studio / Groq hesabından götürün)
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Yalnız köçürmə günü lazımdır, sonra silin ---
# Supabase Dashboard → Connect → Session pooler bağlantı sətri (şifrə daxil)
CLOUD_DB_URL=
# Supabase Dashboard → Project Settings → API Keys → service_role (legacy) və ya secret açar
CLOUD_SERVICE_ROLE_KEY=
CLOUD_URL=https://ttfsbgbhyomfheglefkn.supabase.co
