{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/jobs/:path*", "destination": "/index.html" },
    { "source": "/companies/:path*", "destination": "/index.html" },
    { "source": "/events/:path*", "destination": "/index.html" },
    { "source": "/network/:path*", "destination": "/index.html" },
    { "source": "/profile/:path*", "destination": "/index.html" },
    { "source": "/cv/:path*", "destination": "/index.html" },
    { "source": "/interview/:path*", "destination": "/index.html" },
    { "source": "/career-ai/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
